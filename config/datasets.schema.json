{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contrato de bases temporais do Grupo 5",
  "type": "object",
  "required": ["datasets"],
  "properties": {
    "datasets": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "source", "target", "frequency", "forecast_horizon", "external_variables"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "object", "required": ["column", "unit"]},
          "frequency": {"type": "string", "minLength": 1},
          "forecast_horizon": {"type": "integer", "minimum": 1},
          "external_variables": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["name", "availability", "evidence"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "availability": {"enum": ["known_in_advance", "forecast_at_origin", "lag_only", "excluded"]},
                "evidence": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
